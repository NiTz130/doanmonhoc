  "cards": [
    {
      "dot": "cyan",
      "title": "Ai là ai trong sơ đồ",
      "items": [
        "Frontend = web/app.js · FastAPI = api/app.py · Tác vụ nền = api/viec.py",
        "Điều phối = pipeline/dieu_phoi.py — dùng chung cho cả web lẫn CLI main.py",
        "DeepSeek = api.deepseek.com, gọi qua OpenAI SDK (timeout 120 s, retry 2)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Vì sao có hai lượt chay()",
      "items": [
        "Lượt 1 dừng ở cho_chon_khung và NHẢ .lock để người dùng ngồi vẽ bao lâu cũng được",
        "Lượt 2 giành lại .lock, dùng lại toàn bộ cache của lượt 1 nhờ manifest",
        "checkpoint ghim nguồn phụ đề đã chọn nên gửi hộp không làm ASR chạy lại"
      ]
    },
    {
      "dot": "rose",
      "title": "Những chỗ khoá chặt",
      "items": [
        "Claim .lock mở bằng chế độ \"x\": kiểm exists() rồi tạo sau là một khe hở, không phải claim",
        "Checkpoint tiêu thụ nguyên tử dưới threading.Lock nên hai POST hộp không tạo hai tác vụ",
        "Restart server: job dở bị đánh loi kèm hướng dẫn, không treo mãi ở dang_chay"
      ]
    }
  ]
