#!/bin/sh
# Chặn commit vào main hoặc vào nhánh không phải của mình.
nhanh=$(git symbolic-ref --short HEAD 2>/dev/null)
cua_toi=$(git config nhom.nhanh)

if [ "$nhanh" = "main" ]; then
	echo "DUNG LAI: dang o nhanh main. Khong duoc commit vao main."
	echo "  Chay: git switch ${cua_toi:-<nhanh-cua-ban>}"
	exit 1
fi

if [ -n "$cua_toi" ] && [ "$nhanh" != "$cua_toi" ]; then
	echo "DUNG LAI: dang o nhanh '$nhanh', nhanh cua ban la '$cua_toi'."
	echo "  Chay: git switch $cua_toi"
	exit 1
fi
