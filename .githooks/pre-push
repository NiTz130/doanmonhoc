#!/bin/sh
# Khoá an toàn CHỈ bật khi bạn đã khai báo nhánh riêng:
#     git config nhom.nhanh feat/asr
# Chưa khai báo thì bạn đang làm một mình trên main và hook không cản.
cua_toi=$(git config nhom.nhanh)

[ -z "$cua_toi" ] && exit 0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
	case "$remote_ref" in
		refs/heads/main)
			echo "DUNG LAI: khong duoc push thang len main."
			echo "  Push len $cua_toi, roi mo Pull Request tren github.com."
			exit 1
			;;
	esac
	if [ "$remote_ref" != "refs/heads/$cua_toi" ]; then
		echo "DUNG LAI: dang push len '$remote_ref', nhanh cua ban la '$cua_toi'."
		exit 1
	fi
done
